-- 최초 1회 실행용 예시. 실행 전 CHANGE_ME 값을 openssl rand -base64 24 등으로 만든 값으로 바꾼다.
-- 비밀번호는 Git에 커밋하지 않는다. 이 파일은 복사본을 서버에서만 수정·실행하고 바로 삭제한다.
-- 기존 DB가 있으면 아래 CREATE 문은 이미 존재해 실패할 수 있다. 데이터 삭제 명령은 포함하지 않는다.

CREATE DATABASE IF NOT EXISTS busan_local_food
  CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci;

-- 스키마 적용 전용 관리 계정 (소켓 접속, localhost). 수동 SQL 001~008 실행 후 비활성화하거나 삭제한다.
CREATE USER IF NOT EXISTS 'busan_admin'@'localhost' IDENTIFIED BY 'CHANGE_ME_ADMIN_PASSWORD';
GRANT ALL PRIVILEGES ON busan_local_food.* TO 'busan_admin'@'localhost';

-- 애플리케이션 계정: 필요한 DML만. DDL 권한 없음 (ddl-auto none).
CREATE USER IF NOT EXISTS 'busan_app'@'127.0.0.1' IDENTIFIED BY 'CHANGE_ME_APP_DB_PASSWORD';
GRANT SELECT, INSERT, UPDATE, DELETE ON busan_local_food.* TO 'busan_app'@'127.0.0.1';

-- 백업 계정: mysqldump에 필요한 읽기 권한만. 쓰기·DDL 없음 (SHOW_ROUTINE만 전역 범위).
CREATE USER IF NOT EXISTS 'busan_backup'@'127.0.0.1' IDENTIFIED BY 'CHANGE_ME_BACKUP_DB_PASSWORD';
GRANT SELECT, SHOW VIEW, TRIGGER, EVENT, LOCK TABLES ON busan_local_food.* TO 'busan_backup'@'127.0.0.1';
-- 루틴(프로시저·함수) 정의를 덤프하려면 SHOW_ROUTINE이 필요하다 (MySQL 8.0.22 이상).
-- 이 권한은 전역(*.*)에만 줄 수 있다. DB 단위 GRANT는 오류 3619가 난다.
-- 없으면 mysqldump --routines가 루틴을 조용히 빼고도 종료 코드 0을 낸다 (실제 검증으로 확인).
-- 이 권한은 메타데이터 조회만 허용한다. 루틴 실행, 생성, 변경 권한은 아니다.
GRANT SHOW_ROUTINE ON *.* TO 'busan_backup'@'127.0.0.1';

FLUSH PRIVILEGES;
