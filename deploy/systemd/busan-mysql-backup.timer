# 매일 KST 03:20 에 백업 실행. 설치: /etc/systemd/system/busan-mysql-backup.timer
# EC2 시간대를 Asia/Seoul로 맞춘 전제 (setup-ec2.sh가 설정한다).
# Persistent=true: 꺼져 있던 시각을 놓쳤으면 다음 부팅 뒤 한 번 실행한다.
[Unit]
Description=Daily MySQL backup timer

[Timer]
OnCalendar=*-*-* 03:20:00
Persistent=true
RandomizedDelaySec=0

[Install]
WantedBy=timers.target
