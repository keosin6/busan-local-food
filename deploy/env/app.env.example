# 운영 환경변수 예시 파일. 실제 값은 EC2의 /etc/busan-local-food/app.env에만 둔다.
# 이 파일을 복사해 값을 채우고, 소유자 root:busan, 권한 640으로 둔다. Git에 실제 값을 커밋하지 않는다.
# 형식: KEY=VALUE, 따옴표를 쓰지 않는다. 주석은 줄 맨 앞에만 쓴다.

# --- 필수 (기동 시 없거나 잘못되면 실패) ---
SPRING_PROFILES_ACTIVE=prod

# DB 접속 (EC2 내부 MySQL). 3306은 외부에 열지 않는다. 운영 DB는 SSL을 사용한다.
DB_URL=jdbc:mysql://127.0.0.1:3306/busan_local_food?characterEncoding=UTF-8&sslMode=REQUIRED
DB_USERNAME=busan_app
DB_PASSWORD=CHANGE_ME_APP_DB_PASSWORD

# JWT 서명 키. Base64, 디코딩 후 32바이트 이상. JWT_SECRET과 AUTH_RATE_LIMIT_HMAC_SECRET은 서로 달라야 한다.
# 생성 예: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_BASE64_32BYTES_OR_MORE

# 요청 제한 HMAC 키. Base64, 디코딩 후 32바이트 이상. 위 JWT_SECRET과 다른 값을 쓴다.
AUTH_RATE_LIMIT_HMAC_SECRET=CHANGE_ME_BASE64_32BYTES_OR_MORE_DIFFERENT

# Google OAuth2. 운영(prod)에서는 둘 다 필수다. 한쪽만 있으면 기동하지 않는다.
# 도메인과 HTTPS 연결 전에는 Google 콜백 주소를 등록할 수 없으므로 실제 로그인은 검증할 수 없다 (docs/DEPLOYMENT.md 8절).
GOOGLE_CLIENT_ID=CHANGE_ME_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=CHANGE_ME_GOOGLE_CLIENT_SECRET

# 이미지 저장 S3 버킷 (기존 버킷, 공개 읽기 정책은 docs/DEPLOYMENT.md 9절 참고). 자격 증명은 EC2 인스턴스 역할을 쓴다.
AWS_REGION=CHANGE_ME_AWS_REGION
AWS_S3_BUCKET=CHANGE_ME_IMAGE_BUCKET_NAME

# 신뢰 프록시. Nginx가 같은 EC2에서 127.0.0.1로 연결하므로 그 주소만 신뢰한다. 비워 두면 모든 사용자가 같은 IP로 집계된다.
APP_SECURITY_TRUSTED_PROXIES=127.0.0.1

# --- 선택 (없으면 기능이 UNAVAILABLE로 동작하며 기동은 성공) ---
# AI 리뷰 요약·추천용 OpenRouter. 없으면 외부 호출 없이 UNAVAILABLE이다.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# --- 선택 (기본값 있음) ---
JWT_ACCESS_TOKEN_EXPIRY_SECONDS=1800
JWT_REFRESH_TOKEN_EXPIRY_SECONDS=1209600

# --- 운영 금지 ---
# AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY는 넣지 않는다. EC2 인스턴스 역할을 쓴다.
